# MYSQL_DATABASE：本地 MySQL 数据库名称，示例值 cooperation。
MYSQL_DATABASE=cooperation

# MYSQL_USER：后端连接数据库使用的业务账号，禁止生产环境使用 root。
MYSQL_USER=cooperation_user

# MYSQL_PASSWORD：后端连接数据库使用的密码，示例值必须在真实环境中替换。
MYSQL_PASSWORD=change_me

# MYSQL_ROOT_PASSWORD：MySQL root 初始化密码，真实环境必须使用强密码。
MYSQL_ROOT_PASSWORD=change_root_me

# MYSQL_PORT：宿主机暴露的 MySQL 端口，取值范围 1-65535。
MYSQL_PORT=3306

# BACKEND_PORT：后端 HTTP 服务端口，取值范围 1-65535。
BACKEND_PORT=8080

# FRONTEND_PORT：前端开发或预览服务端口，取值范围 1-65535。
FRONTEND_PORT=5173

# SPRING_PROFILES_ACTIVE：后端激活环境，常用值 local、test、prod。
SPRING_PROFILES_ACTIVE=local

# APP_FILE_STORAGE_ROOT：后端文件存储根目录，必须限制在可控目录内。
APP_FILE_STORAGE_ROOT=./data/storage

# APP_AES_KEY：SMTP 密码加密密钥，必须是 64 位十六进制字符串；生产环境必须替换。
APP_AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# VITE_API_BASE_URL：浏览器访问后端接口的基础地址。
VITE_API_BASE_URL=http://localhost:8080

# MAIL_ENABLED：是否启用真实 SMTP 邮件发送，未配置时发送接口会明确失败。
MAIL_ENABLED=false

# MAIL_HOST：SMTP 服务器地址，例如 smtp.qq.com、smtp.163.com 或企业邮箱 SMTP。
MAIL_HOST=

# MAIL_PORT：SMTP 端口，SSL 常用 465，STARTTLS 常用 587。
MAIL_PORT=465

# MAIL_USERNAME：SMTP 登录账号，通常是发件邮箱。
MAIL_USERNAME=

# MAIL_PASSWORD：SMTP 授权码或密码，示例文件不得填写真实值。
MAIL_PASSWORD=

# MAIL_FROM：发件人邮箱，通常与 MAIL_USERNAME 保持一致。
MAIL_FROM=

# MAIL_SSL_ENABLED：是否启用 SSL 直连模式，取值 true 或 false。
MAIL_SSL_ENABLED=true

# MAIL_STARTTLS_ENABLED：是否启用 STARTTLS，取值 true 或 false。
MAIL_STARTTLS_ENABLED=false
